# Harf settings template. Copy to .env and fill in locally; .env is never committed.
# Only src/harf/config.py reads these values.

# Root folder for datasets and manifests (on Colab: a Google Drive path).
HARF_DATA_ROOT=

# Root folder for checkpoints and evaluation outputs (on Colab: a Google Drive path).
HARF_OUTPUT_ROOT=

# Hugging Face token, needed only from Phase 7 (D-21). Secret: never print or share it.
HF_TOKEN=
